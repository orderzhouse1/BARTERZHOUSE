# =============================================================================
# BARTERZHOUSE / Baddelha — environment placeholders
# Copy to .env (and apps/web/.env, apps/api/.env as needed). Do not commit secrets.
# =============================================================================

NODE_ENV=development

# --- Ports / origins (keep environment-configurable; do not hard-code alternates) ---
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Neon PostgreSQL (required when AUTH_PERSISTENCE=prisma or NODE_ENV=production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Persistence: memory (local/tests without Neon) | prisma (real database)
AUTH_PERSISTENCE=memory

# --- Web (public) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- JWT (use long random secrets locally; never commit real values) ---
JWT_ACCESS_SECRET=replace-with-at-least-32-char-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-char-refresh-secret
JWT_ISSUER=barterzhouse-api
JWT_AUDIENCE=barterzhouse-web
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- CSRF ---
CSRF_SECRET=replace-with-at-least-32-char-csrf-secret

# --- Cookies ---
COOKIE_ACCESS_NAME=barter_access
COOKIE_REFRESH_NAME=barter_refresh
COOKIE_CSRF_NAME=barter_csrf
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Password hashing (argon2id) ---
PASSWORD_HASH_MEMORY_COST=19456
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_PARALLELISM=1

# --- Email delivery abstraction ---
# memory | development | production
EMAIL_DELIVERY_MODE=development
EMAIL_FROM=noreply@localhost
EMAIL_VERIFICATION_URL=http://localhost:3000/ar/verify-email
PASSWORD_RESET_URL=http://localhost:3000/ar/reset-password

# =============================================================================
# Future phases (commented — not required in Phase 1)
# =============================================================================
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=
# STORAGE_REGION=
