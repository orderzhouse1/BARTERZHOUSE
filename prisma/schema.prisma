// Phase 1 — Authentication and profiles for Neon PostgreSQL.
// Migration SQL is generated under prisma/migrations; do not claim live Neon apply
// unless migrate deploy was actually run against a real database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PreferredLocale {
  ar
  en
}

enum AuthAuditEvent {
  REGISTERED
  LOGIN_SUCCESS
  LOGIN_FAILURE
  PASSWORD_RESET
  SESSION_REVOKED
  ACCOUNT_DEACTIVATED
  EMAIL_VERIFIED
  REFRESH_REUSE_DETECTED
}

model User {
  id              String        @id @default(cuid())
  email           String
  normalizedEmail String        @unique @map("normalized_email")
  passwordHash    String        @map("password_hash")
  role            UserRole      @default(USER)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?     @map("email_verified_at")
  lastLoginAt     DateTime?     @map("last_login_at")
  deactivatedAt   DateTime?     @map("deactivated_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  profile                 UserProfile?
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  authAuditLogs           AuthAuditLog[]

  @@map("users")
}

model UserProfile {
  id              String          @id @default(cuid())
  userId          String          @unique @map("user_id")
  displayName     String          @map("display_name")
  bio             String?
  city            String?
  area            String?
  preferredLocale PreferredLocale @default(ar) @map("preferred_locale")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  familyId         String    @map("family_id")
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason")
  userAgent        String?   @map("user_agent")
  ipHash           String?   @map("ip_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([refreshTokenHash])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuthAuditLog {
  id         String         @id @default(cuid())
  userId     String?        @map("user_id")
  event      AuthAuditEvent
  metadata   Json?
  ipHash     String?        @map("ip_hash")
  userAgent  String?        @map("user_agent")
  createdAt  DateTime       @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@map("auth_audit_logs")
}
